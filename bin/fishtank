#!/usr/bin/env python3
"""An 8-bit fish tank for the terminal.

Renders a pixel aquarium using half-block characters, so every terminal cell
holds two square pixels. Meant to run fullscreen as an Omarchy screensaver,
but it is happy standalone too -- press any key (or Ctrl-C) to leave.
"""

import argparse
import json
import math
import os
import random
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty

# ---------------------------------------------------------------- palette ---

WATER_TOP = (34, 108, 156)
WATER_BOTTOM = (3, 12, 38)
SURFACE = (140, 214, 236)
RAY = (170, 226, 255)

SAND = (206, 176, 112)
SAND_LIGHT = (232, 206, 150)
SAND_DARK = (156, 126, 74)
ROCK = (92, 96, 112)
ROCK_DARK = (58, 62, 78)

WEED = ((30, 140, 82), (22, 108, 64), (46, 170, 104))
GLASS = (118, 176, 196)

INK = (14, 10, 24)
WHITE = (244, 248, 252)

# Fish species: body, belly, accent (fins/tail), pattern, eye ring.
SPECIES = [
    # name,        body,             belly,            accent,           pattern
    ("clownfish",  (238, 126, 34),   (250, 178, 96),   (250, 240, 236),  "bands"),
    ("tang",       (36, 96, 210),    (76, 140, 236),   (248, 206, 60),   "plain"),
    ("guppy",      (222, 92, 138),   (250, 158, 190),  (154, 226, 240),  "spots"),
    ("neon",       (46, 196, 212),   (140, 240, 246),  (238, 76, 92),    "stripe"),
    ("goldfish",   (240, 158, 40),   (252, 206, 120),  (248, 226, 150),  "plain"),
    ("angel",      (232, 224, 96),   (248, 244, 190),  (255, 248, 210),  "bands"),
    ("betta",      (152, 74, 214),   (198, 130, 244),  (236, 84, 176),   "plain"),
    ("cardinal",   (214, 48, 62),    (244, 118, 118),  (250, 186, 160),  "stripe"),
]


def clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


def mix(a, b, t):
    t = clamp(t, 0.0, 1.0)
    return (
        int(a[0] + (b[0] - a[0]) * t),
        int(a[1] + (b[1] - a[1]) * t),
        int(a[2] + (b[2] - a[2]) * t),
    )


def shade(c, f):
    return (clamp(int(c[0] * f), 0, 255),
            clamp(int(c[1] * f), 0, 255),
            clamp(int(c[2] * f), 0, 255))


def pack(c):
    return (c[0] << 16) | (c[1] << 8) | c[2]


# ----------------------------------------------------------------- sprites ---

class Sprite:
    """A little bag of (x, y, packed-colour) pixels."""

    __slots__ = ("w", "h", "pixels")

    def __init__(self, w, h, pixels):
        self.w = w
        self.h = h
        self.pixels = pixels

    @classmethod
    def from_art(cls, rows, palette):
        pixels = []
        for y, row in enumerate(rows):
            for x, ch in enumerate(row):
                if ch == "." or ch == " ":
                    continue
                pixels.append((x, y, pack(palette[ch])))
        return cls(max(len(r) for r in rows), len(rows), pixels)

    def mirrored(self):
        w = self.w
        return Sprite(w, self.h, [(w - 1 - x, y, c) for x, y, c in self.pixels])

    def scaled(self, s):
        if s == 1:
            return self
        pixels = []
        for x, y, c in self.pixels:
            for dy in range(s):
                for dx in range(s):
                    pixels.append((x * s + dx, y * s + dy, c))
        return Sprite(self.w * s, self.h * s, pixels)

    def tinted(self, target, t):
        if t <= 0.0:
            return self
        pixels = []
        for x, y, c in self.pixels:
            col = ((c >> 16) & 255, (c >> 8) & 255, c & 255)
            pixels.append((x, y, pack(mix(col, target, t))))
        return Sprite(self.w, self.h, pixels)


def fish_art(w, h, species, flap):
    """Generate one frame of a fish, facing right, as rows of palette keys.

    Tail fan first, then a teardrop body painted over its root so the two
    never separate, then fins, pattern, face and finally a dark outline --
    the order an 8-bit sprite would be drawn in by hand. `flap` (-1, 0, 1)
    swings the tail tip for the swim cycle.
    """
    name, body, belly, accent, pattern = species
    bx = max(2, int(round(w * 0.26)))     # tail occupies x < bx
    cy = (h - 1) / 2.0
    b = (h - 1) / 2.0 - 0.1               # body half-height
    span = float(max(1, w - 1 - bx))

    grid = [["." for _ in range(w)] for _ in range(h)]

    def body_half(x):
        """Half-height of the body at column x: thin at the tail joint,
        widest just past the middle, rounded off at the snout."""
        t = clamp((x - bx) / span, 0.0, 1.0)
        rise = min(1.0, 1.8 * t ** 0.6)
        snout = 1.0 - 0.72 * max(0.0, (t - 0.52) / 0.48) ** 1.7
        return b * rise * snout

    def fill(x, centre, half, key, over=None):
        if half < 0.0:
            return
        for y in range(int(round(centre - half)), int(round(centre + half)) + 1):
            if 0 <= y < h and (over is None or grid[y][x] in over):
                grid[y][x] = key

    # Tail: a fan, forked at the tip, swinging with the flap.
    tip = cy + flap * (b * 0.5)
    for x in range(0, bx + 1):
        t = 1.0 - (x / float(bx))          # 0 at the body joint, 1 at the tip
        spread = max(0.6, b * (0.22 + 0.78 * t ** 0.75))
        centre = cy + (tip - cy) * t
        lo = int(round(centre - spread))
        hi = int(round(centre + spread))
        notch = spread * 0.5 if t > 0.75 else 0.0
        for y in range(lo, hi + 1):
            if 0 <= y < h and abs(y - centre) >= notch - 0.4:
                grid[y][x] = "A"

    # Body, painted over the root of the tail.
    for x in range(bx, w):
        fill(x, cy, body_half(x), "B")

    # Dorsal fin on top, pelvic fin below.
    for x in range(bx + 1, w - 2):
        t = (x - bx) / span
        if 0.12 < t < 0.62:
            rise = 1 + (1 if h >= 11 and 0.25 < t < 0.5 else 0)
            top = int(round(cy - body_half(x)))
            for d in range(1, rise + 1):
                if 0 <= top - d < h and grid[top - d][x] == ".":
                    grid[top - d][x] = "A"
        if 0.20 < t < 0.45 and h >= 9:
            bottom = int(round(cy + body_half(x)))
            if 0 <= bottom + 1 < h and grid[bottom + 1][x] == ".":
                grid[bottom + 1][x] = "A"

    # Pectoral fin: a short nub on the flank behind the gills.
    fx = bx + int(span * 0.58)
    fy = int(round(cy + body_half(fx) * 0.62))
    for dx in range(max(2, w // 7)):
        if 0 <= fx + dx < w and 0 <= fy < h and grid[fy][fx + dx] == "B":
            grid[fy][fx + dx] = "A"

    # Belly: lighten the lowest body pixel in each column.
    for x in range(bx, w):
        col = [y for y in range(h) if grid[y][x] == "B"]
        if len(col) > 2:
            grid[col[-1]][x] = "L"

    # Pattern
    if pattern == "bands":
        band = max(2, w // 6)
        for x in range(bx + 1, w - 2):
            if ((x - bx) // band) % 2 == 0:
                for y in range(h):
                    if grid[y][x] in "BL":
                        grid[y][x] = "D"
    elif pattern == "stripe":
        for y in (int(round(cy)), int(round(cy)) - 1):
            for x in range(bx, w - 1):
                if 0 <= y < h and grid[y][x] in "BL":
                    grid[y][x] = "D"
    elif pattern == "spots":
        rnd = random.Random(sum(body) * 31 + w)
        for _ in range(max(3, w // 3)):
            sx = rnd.randrange(bx + 1, w - 1)
            sy = rnd.randrange(0, h)
            if grid[sy][sx] == "B":
                grid[sy][sx] = "D"

    # Gill line, one darker column behind the head.
    gx = bx + int(round(span * 0.74))
    for y in range(h):
        if grid[y][gx] in "BLD":
            grid[y][gx] = "O"

    # Eye: an ink block with a white highlight, the classic 8-bit look.
    ex = bx + int(round(span * 0.84))
    ey = int(round(cy - body_half(ex) * 0.42))
    eye = 2 if h >= 9 else 1
    for dy in range(eye):
        for dx in range(eye):
            x, y = ex + dx, ey + dy
            if 0 <= x < w and 0 <= y < h and grid[y][x] in "BLD":
                grid[y][x] = "K"
    if 0 <= ex < w and 0 <= ey < h and grid[ey][ex] == "K":
        grid[ey][ex] = "W"

    # Mouth at the snout.
    mx = w - 1
    my = int(round(cy + body_half(mx) * 0.55))
    if 0 <= my < h and grid[my][mx] in "BLD":
        grid[my][mx] = "O"

    # Outline: pad by a pixel, then darken every empty pixel touching the fish.
    pw, ph = w + 2, h + 2
    padded = [["." for _ in range(pw)] for _ in range(ph)]
    for y in range(h):
        for x in range(w):
            padded[y + 1][x + 1] = grid[y][x]
    grid = [row[:] for row in padded]
    for y in range(ph):
        for x in range(pw):
            if padded[y][x] != ".":
                continue
            for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                ny, nx = y + dy, x + dx
                if 0 <= ny < ph and 0 <= nx < pw and padded[ny][nx] != ".":
                    grid[y][x] = "E"
                    break

    outline = mix(shade(body, 0.30), INK, 0.45)
    palette = {
        "B": body,
        "A": mix(accent, WHITE, 0.10),
        "L": belly,
        "D": shade(body, 0.52),
        "O": mix(outline, body, 0.45),
        "E": outline,
        "W": WHITE,
        "K": INK,
    }
    return ["".join(row) for row in grid], palette


def build_fish_frames(w, h, species):
    frames = []
    for flap in (-1, 0, 1, 0):
        rows, palette = fish_art(w, h, species, flap)
        frames.append(Sprite.from_art(rows, palette))
    return frames


